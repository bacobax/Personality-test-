{
  "source": {
    "name": "IPIP Big-Five Factor Markers (public domain), item responses from the Open Psychometrics IPIP-FFM dataset (collected 2016-2018)",
    "key_page": "https://ipip.ori.org/newBigFive5broadKey.htm",
    "dataset": "https://openpsychometrics.org/_rawdata/IPIP-FFM-data-8Nov2018.zip"
  },
  "scales": {
    "EXT": { "ipip_factor": "Surgency / Extraversion", "dimension": "sociability", "same_pole": true },
    "EST": { "ipip_factor": "Emotional Stability", "dimension": "anxiety", "same_pole": false },
    "AGR": { "ipip_factor": "Agreeableness", "dimension": "empathy", "same_pole": true },
    "CSN": { "ipip_factor": "Conscientiousness", "dimension": "discipline", "same_pole": true },
    "OPN": { "ipip_factor": "Intellect / Imagination", "dimension": "openness", "same_pole": true }
  },
  "items": {
    "EXT1": { "ipip_key": "+" },
    "EXT2": { "ipip_key": "-" },
    "AGR1": { "ipip_key": "-" },
    "EST1": { "ipip_key": "-" },
    "CSN2": { "ipip_key": "-" }
  },
  "notes": {
    "same_pole": "false when the IPIP factor runs opposite to our dimension (Emotional Stability vs our Anxiety), so the sign flips once more.",
    "loading_sign": "sign(loading) = (ipip_key '+' ? +1 : -1) * (same_pole ? +1 : -1)"
  }
}
